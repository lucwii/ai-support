                  "  pm.expect(pm.response.json().data.logs).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('at least one log entry exists (ai_response_generated)', function () {",
                  "  const logs = pm.response.json().data.logs;",
                  "  pm.expect(logs.length).to.be.above(0);",
                  "  const actions = logs.map(l => l.action);",
                  "  pm.expect(actions).to.include('ai_response_generated');",
                  "});"
                ]
