        {
          "name": "Get All Tickets - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success: true', function () {",
                  "  pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "pm.test('data is an array', function () {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('total matches data length', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.total).to.equal(json.data.length);",
                  "});",
                  "",
                  "pm.test('each ticket has required fields', function () {",
                  "  const tickets = pm.response.json().data;",
                  "  tickets.forEach(function (ticket) {",
                  "    pm.expect(ticket).to.have.property('id');",
                  "    pm.expect(ticket).to.have.property('organization_id');",
                  "    pm.expect(ticket).to.have.property('content');",
                  "    pm.expect(ticket).to.have.property('status');",
                  "    pm.expect(ticket).to.have.property('created_at');",
                  "  });",
                  "});"
                ]
              }
            }
