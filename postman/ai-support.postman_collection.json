    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket - Success (triggers AI pipeline)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success: true', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('data.ticket exists with required fields', function () {",
                  "  const ticket = pm.response.json().data.ticket;",
                  "  pm.expect(ticket).to.have.property('id');",
                  "  pm.expect(ticket).to.have.property('organization_id');",
                  "  pm.expect(ticket).to.have.property('content');",
                  "  pm.expect(ticket).to.have.property('status');",
                  "  pm.expect(ticket).to.have.property('created_at');",
                  "});",
                  "",
                  "pm.test('ticket.status is auto_answered or pending_agent', function () {",
                  "  const status = pm.response.json().data.ticket.status;",
                  "  pm.expect(['auto_answered', 'pending_agent']).to.include(status);",
                  "});",
                  "",
                  "pm.test('ticket.ai_response is a non-empty string', function () {",
                  "  const ai_response = pm.response.json().data.ticket.ai_response;",
                  "  pm.expect(ai_response).to.be.a('string').and.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('ticket.confidence is between 0 and 100', function () {",
                  "  const confidence = pm.response.json().data.ticket.confidence;",
                  "  pm.expect(confidence).to.be.at.least(0).and.at.most(100);",
                  "});",
                  "",
                  "pm.test('wasAutoAnswered is boolean', function () {",
                  "  const wasAutoAnswered = pm.response.json().data.wasAutoAnswered;",
                  "  pm.expect(wasAutoAnswered).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('message is present', function () {",
                  "  const message = pm.response.json().data.message;",
                  "  pm.expect(message).to.be.a('string').and.have.length.above(0);",
                  "});",
                  "",
                  "// Sacuvaj ticket_id za sledece testove",
                  "const ticketId = pm.response.json().data.ticket.id;",
                  "if (ticketId) {",
                  "  pm.collectionVariables.set('ticket_id', ticketId);",
                  "  console.log('Saved ticket_id:', ticketId);",
                  "}"
                ]
              }
            }
          ],
